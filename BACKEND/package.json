{
  "name": "king-ice-quiz-backend",
  "version": "2.0.0",
  "description": "Backend for King Ice Quiz with Real-time Chat",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'Building...'",
    "test": "jest --verbose --detectOpenHandles",
    "test:watch": "jest --watch --verbose",
    "test:coverage": "jest --coverage --verbose",
    "test:auth": "jest tests/auth.test.js --verbose",
    "test:quiz": "jest tests/quiz.test.js --verbose",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed": "node utils/seedDatabase.js",
    "production": "NODE_ENV=production node server.js",
    "prestart": "echo 'Starting King Ice Quiz Backend...'",
    "poststart": "echo 'Backend server started successfully!'"
  },
  "keywords": [
    "quiz",
    "education",
    "nodejs",
    "express",
    "mongodb",
    "api",
    "backend",
    "socket.io",
    "chat",
    "real-time",
    "authentication"
  ],
  "author": "King Ice Quiz Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.4",
    "multer-storage-cloudinary": "^4.0.0",
    "socket.io": "^4.7.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "eslint": "^8.46.0",
    "jest": "^29.6.2",
    "mongodb-memory-server": "^8.13.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "models/**/*.js",
      "middleware/**/*.js",
      "utils/**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "repository": {
    "type": "git",
    "url": "your-repository-url"
  },
  "bugs": {
    "url": "your-issues-url"
  },
  "homepage": "https://your-app.vercel.app"
}
